<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titulo }} · OncoGO-CRC</title>
<link rel="preload" href="/fuentes/source-sans-3-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fuentes/source-sans-3-600.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fuentes/source-serif-4-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/{{ css }}">
</head>
<body{% if portada %} class="portada"{% endif %}>
<a class="saltar" href="#contenido">Saltar al contenido</a>
<header class="barra">
<button type="button" id="abrir-exploracion" aria-expanded="false" aria-controls="exploracion">Menú</button>
<a class="marca" href="/">OncoGO-CRC</a>
<form class="buscar" action="/buscar" method="get" role="search">
<label class="saltar" for="q">Buscar</label>
<input id="q" name="q" type="search" placeholder="Proteína, término o página" value="{{ consulta }}">
<button type="submit">Buscar</button>
</form>
<button type="button" id="tema">Tema</button>
</header>
<p class="aviso">{{ aviso }}</p>
<div class="marco">
<aside id="exploracion" class="lateral" aria-label="Principal">
<p class="lateral-etiqueta">Explorar la investigación</p>
<a class="lateral-inicio" href="/">Inicio</a>
{% for grupo in exploracion %}
<nav class="lateral-grupo" aria-label="{{ grupo.grupo }}">
<p>{{ grupo.grupo }}</p>
{% for item in grupo.enlaces %}
<a href="{{ item.ruta }}">{{ item.nombre }}</a>
{% endfor %}
</nav>
{% endfor %}
</aside>
<div class="velo" id="velo" hidden></div>
<div class="columna">
{% if migas %}<p class="migas">{{ migas }}</p>{% endif %}
{% if indice and not portada %}
<nav class="indice" aria-label="En esta página">
{% for ancla in indice %}
<a href="#{{ ancla.id }}">{{ ancla.texto }}</a>
{% endfor %}
</nav>
{% endif %}
<main id="contenido">
{% if hermanas %}
<nav class="hermanas" aria-label="En esta sección">
{% for item in hermanas %}
<a href="{{ item.ruta }}">{{ item.nombre }}</a>
{% endfor %}
</nav>
{% endif %}
{{ cuerpo | safe }}
{% if fuentes %}
<details class="transparencia">
<summary>Transparencia y trazabilidad</summary>
<ul>
{% for fuente in fuentes %}
<li><a href="{{ fuente.href }}">{{ fuente.texto }}</a></li>
{% endfor %}
</ul>
</details>
{% endif %}
</main>
</div>
</div>
<footer class="pie">
<nav class="secundario" aria-label="Más páginas">
{% for item in secundario %}
<a href="{{ item.ruta }}">{{ item.nombre }}</a>
{% endfor %}
</nav>
<p>Resultados v3.7-final · certificado {{ franja_estado | safe }} · sello {{ franja_sello | safe }}.</p>
<p><a href="/bibliografia">Cómo citar</a> · <a href="https://github.com/JancoDeveloper/OncoGO-CRC">Repositorio</a></p>
<p class="aviso">{{ aviso }}</p>
</footer>
<script>{{ js | safe }}</script>
{% if js_extra %}<script>{{ js_extra | safe }}</script>{% endif %}
</body>
</html>
