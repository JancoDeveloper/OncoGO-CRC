{"annotationScore": 5.0, "comments": [{"commentType": "FUNCTION", "texts": [{"evidences": [{"evidenceCode": "ECO:0000269", "id": "26841837", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "27052168", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "30552328", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "39814882", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "39914456", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "6833260", "source": "PubMed"}], "value": "Component of the membrane attack complex (MAC), a multiprotein complex activated by the complement cascade, which inserts into a target cell membrane and forms a pore, leading to target cell membrane rupture and cell lysis (PubMed:26841837, PubMed:27052168, PubMed:30552328). The MAC is initiated by proteolytic cleavage of C5 into complement C5b in response to the classical, alternative, lectin and GZMK complement pathways (PubMed:30552328, PubMed:39914456, PubMed:39814882). The complement pathways consist in a cascade of proteins that leads to phagocytosis and breakdown of pathogens and signaling that strengthens the adaptive immune system (PubMed:30552328). C8G, together with C8A and C8B, inserts into the target membrane, but does not form pores by itself (PubMed:30552328). During MAC assembly, associates with C5b, C6 and C7 to form the C5b8 intermediate complex that inserts into the target membrane and traverses the bilayer increasing membrane rigidity (PubMed:30552328, PubMed:6833260)"}]}, {"commentType": "ACTIVITY REGULATION", "texts": [{"evidences": [{"evidenceCode": "ECO:0000269", "id": "34667172", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "36797260", "source": "PubMed"}], "value": "Membrane attack complex (MAC) assembly is inhibited by CD59, thereby protecting self-cells from damage during complement activation (PubMed:36797260). MAC assembly is also inhibited by clusterin (CLU) chaperones that inhibit polymerization of C9 (PubMed:34667172)"}]}, {"commentType": "SUBUNIT", "texts": [{"evidences": [{"evidenceCode": "ECO:0000269", "id": "17692377", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "21454577", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "26841837", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "27052168", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "30552328", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "31061395", "source": "PubMed"}], "value": "Heterotrimer of 3 chains: alpha (C8A), beta (C8B) and gamma (C8G); the alpha and gamma chains are disulfide bonded (PubMed:17692377, PubMed:21454577). Component of the membrane attack complex (MAC), composed of complement C5b, C6, C7, C8A, C8B, C8G and multiple copies of the pore-forming subunit C9 (PubMed:26841837, PubMed:27052168, PubMed:30552328, PubMed:31061395)"}]}, {"commentType": "INTERACTION", "interactions": [{"interactantOne": {"intActId": "EBI-9021652", "uniProtKBAccession": "P07360"}, "interactantTwo": {"geneName": "UBQLN2", "intActId": "EBI-947187", "uniProtKBAccession": "Q9UHD9"}, "numberOfExperiments": 3, "organismDiffer": false}]}, {"commentType": "SUBCELLULAR LOCATION", "note": {"texts": [{"evidences": [{"evidenceCode": "ECO:0000269", "id": "30552328", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "31061395", "source": "PubMed"}], "value": "Secreted as soluble protein (PubMed:30552328). Inserts into the cell membrane of target cells (PubMed:30552328, PubMed:31061395)"}]}, "subcellularLocations": [{"location": {"evidences": [{"evidenceCode": "ECO:0000269", "id": "3676249", "source": "PubMed"}], "id": "SL-0243", "value": "Secreted"}}, {"location": {"evidences": [{"evidenceCode": "ECO:0000269", "id": "30552328", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "31061395", "source": "PubMed"}], "id": "SL-0451", "value": "Target cell membrane"}}]}, {"commentType": "SIMILARITY", "texts": [{"evidences": [{"evidenceCode": "ECO:0000305"}], "value": "Belongs to the calycin superfamily. Lipocalin family"}]}], "entryAudit": {"entryVersion": 229, "firstPublicDate": "1988-04-01", "lastAnnotationUpdateDate": "2026-11-04", "lastSequenceUpdateDate": "2006-10-03", "sequenceVersion": 3}, "entryType": "UniProtKB reviewed (Swiss-Prot)", "extraAttributes": {"countByCommentType": {"ACTIVITY REGULATION": 1, "FUNCTION": 1, "INTERACTION": 1, "SIMILARITY": 1, "SUBCELLULAR LOCATION": 1, "SUBUNIT": 1}, "countByFeatureType": {"Beta strand": 11, "Chain": 1, "Disulfide bond": 2, "Helix": 7, "Modified residue": 1, "Natural variant": 3, "Signal": 1}, "uniParcId": "UPI0000210FCA"}, "features": [{"description": "", "location": {"end": {"modifier": "EXACT", "value": 20}, "start": {"modifier": "EXACT", "value": 1}}, "type": "Signal"}, {"description": "Complement component C8 gamma chain", "featureId": "PRO_0000017881", "location": {"end": {"modifier": "EXACT", "value": 202}, "start": {"modifier": "EXACT", "value": 21}}, "type": "Chain"}, {"description": "Pyrrolidone carboxylic acid", "evidences": [{"evidenceCode": "ECO:0000269", "id": "3676249", "source": "PubMed"}], "location": {"end": {"modifier": "EXACT", "value": 21}, "start": {"modifier": "EXACT", "value": 21}}, "type": "Modified residue"}, {"description": "Interchain (with C-194 in C8-alpha chain)", "evidences": [{"evidenceCode": "ECO:0000269", "id": "12033936", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "17452033", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "17692377", "source": "PubMed"}], "location": {"end": {"modifier": "EXACT", "value": 60}, "start": {"modifier": "EXACT", "value": 60}}, "type": "Disulfide bond"}, {"description": "", "evidences": [{"evidenceCode": "ECO:0000269", "id": "12033936", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "17452033", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "17692377", "source": "PubMed"}, {"evidenceCode": "ECO:0000269", "id": "21454577", "source": "PubMed"}, {"evide