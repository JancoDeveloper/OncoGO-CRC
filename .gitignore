# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.env
*.egg-info/
.eggs/
dist/
build/

# Data & results (keep structure via .gitkeep where needed)
data/raw/**/*.tsv
data/raw/**/*.csv
data/raw/**/*.txt
!data/raw/**/.gitkeep
data/interim/*.tsv
data/processed/*.tsv
/results/**/*
!/results/**/.gitkeep
# v3 se versiona: la tesis cita estas tablas. La caché de Crossref se regenera.
!/results/v3/
!/results/v3/**
/results/v3/crossref_cache/
!/results/v3_2/
!/results/v3_2/**
!/results/v3_2_manifest.sha256
!/results/v3_3/
!/results/v3_3/**
!/results/v3_3_manifest.sha256
/results/v3/crossref_cache/**
/reports/**/*.md
!/reports/**/.gitkeep

# MkDocs
site/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# AppleDouble: ExFAT (el disco externo JANCODATA) crea un ._fichero por fichero.
# No son datos del proyecto.
._*

# Jupyter
.ipynb_checkpoints/

# Demo exception: allow tiny demo outputs if committed — user may gitignore
# Uncomment to ignore all demo-generated files:
# data/**/demo_*
